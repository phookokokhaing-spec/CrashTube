rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function hasActiveAdAccess(uid) {
      return exists(/databases/$(database)/documents/adAccess/$(uid))
        && get(/databases/$(database)/documents/adAccess/$(uid)).data.active == true
        && get(/databases/$(database)/documents/adAccess/$(uid)).data.expiresAt is timestamp
        && request.time < get(/databases/$(database)/documents/adAccess/$(uid)).data.expiresAt;
    }

    match /adAccess/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow create: if isOwner(uid);
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      // Users may update their normal profile/wallet fields, but cannot
      // self-assign a VIP level. Only an Admin may change `level`.
      allow update: if isAdmin()
        || (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['level']));
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /adWatches/{id} {
      allow read: if isAdmin()
        || (signedIn() && id.matches('^' + request.auth.uid + '.*$'));
      allow create, update: if signedIn()
        && id.matches('^' + request.auth.uid + '.*$')
        && hasActiveAdAccess(request.auth.uid);
      allow delete: if isAdmin();
    }

    match /levelUpgradeRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amountMMK == 5000
        && request.resource.data.toLevel == request.resource.data.fromLevel + 1;
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /withdrawals/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /withdrawRequests/{id} {
      allow read, write: if isAdmin();
    }
    match /dailyTop3Rewards/{id} {
      // Only Admin can create reward nominations for users.
      allow create: if isAdmin();
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Public leaderboard: signed-in users may view rankings.
    // Each user may only create/update their own daily entry.
    match /publicLeaderboard/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is string
        && id == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly([
          'userId', 'username', 'date', 'count',
          'totalCoins', 'updatedAt'
        ]);

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date == resource.data.date
        && id == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly([
          'userId', 'username', 'date', 'count',
          'totalCoins', 'updatedAt'
        ]);

      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }


    match /adAccessRequests/{uid} {
      function validPendingAdAccessRequest() {
        return request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'userId', 'email', 'username', 'status', 'requestedAt'
          ]);
      }

      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && validPendingAdAccessRequest();

      allow update: if isAdmin()
        || (isOwner(uid)
          && (
            resource.data.status == 'rejected'
            || (
              resource.data.status == 'approved'
              && resource.data.expiresAt is timestamp
              && resource.data.expiresAt < request.time
            )
          )
          && validPendingAdAccessRequest());

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
