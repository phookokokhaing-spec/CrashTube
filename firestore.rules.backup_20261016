rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Admin authorization must be provisioned in Firestore Console:
    // admins/{uid} = { active: true }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /users/{uid} {
      allow create: if isOwner(uid);
      // The current app uses client-side balance updates. This rule intentionally
      // permits owner updates for compatibility, but production rewards should be
      // moved to trusted Cloud Functions to prevent coin tampering.
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /adWatches/{id} {
      // IDs are currently UID + "_" + date in the CashTube client.
      allow read, create, update: if signedIn()
        && id.matches('^' + request.auth.uid + '.*$');
      allow delete: if isAdmin();
    }

    match /withdrawals/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /withdrawRequests/{id} {
      allow read, write: if isAdmin();
    }

    match /dailyTop3Rewards/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}